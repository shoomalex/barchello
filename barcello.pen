              "children": [
                {
                  "type": "text",
                  "id": "javux",
                  "name": "Story category",
                  "fill": "#A8DE42",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "ТЕКИЛА · ИСТОРИЯ КОКТЕЙЛЯ",
                  "lineHeight": 1.2,
                  "fontFamily": "Inter",
